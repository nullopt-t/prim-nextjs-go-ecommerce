# PRIM backend — environment template
#
# Copy this file to backend/.env for local development:
#     cp backend/.env.example backend/.env
#
# NEVER commit a filled-in .env file.
# Replace every __REPLACE__ value before starting the stack.
#
# The active values below are for the local Docker Compose stack.
# Production alternatives are shown as comments in each section.

# ===== Runtime =====
# development | staging | production
APP_ENV=development

# Backend HTTP port.
# Local dev Compose maps 8081:8081. The production Compose file overrides this
# to 8080. The Next.js frontend container is pinned to 3000 by Compose.
PORT=8081

# Comma-separated browser origins allowed to call the API.
# Never use "*" with credentials.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Public frontend URL used in emails and links.
CLIENT_BASE_URL=http://localhost:3000

# ===== PostgreSQL =====
# Only the full connection URL is used.
# Local Docker example (the dev Compose Postgres uses prim/prim):
DATABASE_URL=postgresql://prim:prim@postgres:5432/prim?sslmode=disable

# Production example (managed database with TLS):
# DATABASE_URL=postgresql://user:password@db.example.com:5432/prim?sslmode=require

# ===== Redis =====
# Only the full connection URL is used.
# Local Docker example (no password inside the Compose network):
REDIS_URL=redis://redis:6379/0

# Production example (password-protected Redis):
# REDIS_URL=redis://default:password@redis.example.com:6379/0

# ===== Object storage (MinIO or AWS S3) =====
# Local Docker MinIO (active defaults):
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=supersecret
MINIO_BUCKET=product-media

# AWS S3 / S3-compatible production example:
# MINIO_ENDPOINT=s3.eu-west-1.amazonaws.com
# MINIO_PUBLIC_URL=https://my-bucket.s3.eu-west-1.amazonaws.com
# MINIO_ACCESS_KEY=AKIAIOSFODNN7EXAMPLE
# MINIO_SECRET_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
# MINIO_BUCKET=my-bucket

# MinIO container initialization. Keep in sync with MINIO_ACCESS_KEY / MINIO_SECRET_KEY.
# These are local-development credentials only; change them for production.
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=supersecret

# ===== Auth =====
# Generate with: openssl rand -base64 48
OTP_HASH_PEPPER=__REPLACE_64_HEX_OR_BASE64__

# Go durations with explicit units. 720h = 30 days.
AUTH_CHALLENGE_TTL=5m
AUTH_SESSION_TTL=720h

# Rate limits. Counts are requests per window; windows require units (1m, 1h).
RL_AUTH_START_REQUESTS=5
RL_AUTH_START_WINDOW=1m
RL_AUTH_RESEND_REQUESTS=3
RL_AUTH_RESEND_WINDOW=1m
RL_AUTH_VERIFY_REQUESTS=10
RL_AUTH_VERIFY_WINDOW=1m

# ===== SMTP =====
# Local development example using Mailpit:
# SMTP_HOST=mailpit
# SMTP_PORT=1025
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=no-reply@localhost
# SMTP_FROM_NAME=Prim

# Production SMTP example:
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=__REPLACE__
SMTP_PASSWORD=__REPLACE__
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_FROM_NAME=Prim

# ===== Kafka =====
# Application settings.
KAFKA_BROKERS=kafka:9092
KAFKA_GROUP_ID=prim-notification-workers

# Kafka container settings for the local Docker Compose KRaft broker.
# These are not application settings; keep them when using the bundled Kafka.
KAFKA_NODE_ID=1
KAFKA_PROCESS_ROLES=broker,controller
KAFKA_LISTENERS=PLAINTEXT://:9092,CONTROLLER://:9093
KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://kafka:9092
KAFKA_CONTROLLER_LISTENER_NAMES=CONTROLLER
KAFKA_LISTENER_SECURITY_PROTOCOL_MAP=PLAINTEXT:PLAINTEXT,CONTROLLER:PLAINTEXT
KAFKA_CONTROLLER_QUORUM_VOTERS=1@kafka:9093
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1
KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR=1
KAFKA_TRANSACTION_STATE_LOG_MIN_ISR=1
KAFKA_GROUP_INITIAL_REBALANCE_DELAY_MS=0
KAFKA_NUM_PARTITIONS=3

# ===== Frontend (Docker Compose) =====
NODE_ENV=production
HOSTNAME=0.0.0.0
# Server-side calls from Next.js to the API container.
API_URL=http://api:8080

# NEXT_PUBLIC_API_URL is compiled into the browser bundle at build time.
# Pass it as a Docker build arg, not just as a runtime variable:
#   docker compose -f backend/docker/docker-compose.prod.yml build \
#     --build-arg NEXT_PUBLIC_API_URL=https://api.example.com frontend
NEXT_PUBLIC_API_URL=http://localhost:8081

# ===== Optional YAML config =====
# Leave unset in production to use env-only mode.
# CONFIG_PATH=/etc/prim/config.yaml
