# PRIM backend — runtime environment template.
# Copy to .env for local dev, or inject these at deploy time.
# NEVER commit a filled-in .env. Replace every __REPLACE__ value.

# ===== Runtime =====
# Container listens on this port. Keep 8080 with the prod compose mapping.
HTTP_PORT=8080
# Comma-separated, explicit origins. Never use "*" with credentials.
CORS_ALLOWED_ORIGINS=https://app.example.com

# ===== PostgreSQL =====
# Optional full connection URL (e.g. for Neon, Supabase, Cloud SQL):
# DATABASE_URL=postgresql://user:password@host:port/dbname?sslmode=require
DB_HOST=postgres
DB_PORT=5432
DB_NAME=prim
DB_USER=prim
DB_PASSWORD=__REPLACE__
# require / verify-full for managed or remote databases; disable only for local Docker.
DB_SSL_MODE=require

# Postgres container initialization. Keep in sync with DB_NAME / DB_USER / DB_PASSWORD.
POSTGRES_DB=prim
POSTGRES_USER=prim
POSTGRES_PASSWORD=__REPLACE__

# ===== Redis =====
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=__REPLACE__
REDIS_DB=0

# ===== Object storage (AWS S3 or MinIO) =====
# For local Docker MinIO:
#   MINIO_ENDPOINT=minio:9000
#   MINIO_PUBLIC_URL=http://localhost:9000
#   MINIO_ACCESS_KEY=admin
#   MINIO_SECRET_KEY=supersecret
#
# For AWS S3:
#   MINIO_ENDPOINT=s3.<region>.amazonaws.com   (e.g. s3.eu-central-1.amazonaws.com or https://s3.amazonaws.com)
#   MINIO_PUBLIC_URL=https://<bucket>.s3.<region>.amazonaws.com (or your CloudFront domain: https://cdn.example.com)
#   MINIO_ACCESS_KEY=AKIAIOSFODNN7EXAMPLE      (your AWS Access Key ID)
#   MINIO_SECRET_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY (your AWS Secret Access Key)
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=supersecret

# MinIO container initialization. Keep in sync with MINIO_ACCESS_KEY / MINIO_SECRET_KEY.
MINIO_ROOT_USER=__REPLACE__
MINIO_ROOT_PASSWORD=__REPLACE__

# ===== Auth =====
# Generate with: openssl rand -base64 48
OTP_HASH_PEPPER=__REPLACE_64_HEX_OR_BASE64__
# Go duration values with explicit units. 720h = 30 days.
AUTH_CHALLENGE_TTL=5m
AUTH_SESSION_TTL=720h
# Request quota per sliding window, and the window duration with an explicit unit.
RL_AUTH_START_REQUESTS=5
RL_AUTH_START_WINDOW=1m
RL_AUTH_RESEND_REQUESTS=3
RL_AUTH_RESEND_WINDOW=1m
RL_AUTH_VERIFY_REQUESTS=10
RL_AUTH_VERIFY_WINDOW=1m

# ===== Client =====
CLIENT_BASE_URL=https://app.example.com

# ===== SMTP =====
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=__REPLACE__
SMTP_PASSWORD=__REPLACE__
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_FROM_NAME=Prim

# ===== Kafka =====
KAFKA_BROKERS=kafka:9092
KAFKA_GROUP_ID=prim-notification-workers

# Optional: only if you deliberately mount a YAML config.
# Leave unset in production to use env-only mode.
# CONFIG_PATH=/etc/prim/config.yaml
