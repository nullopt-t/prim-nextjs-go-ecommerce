# ═══════════════════════════════════════════════════════════════════════════════
# PRIM — Production Environment Configuration Template
# ═══════════════════════════════════════════════════════════════════════════════
#
# Instructions for production deployment:
# 1. Copy this template to backend/.env:
#       cp backend/.env.production.example backend/.env
# 2. Replace every placeholder below with your real cloud credentials and domain names.
# 3. Choose your deployment model:
#       - All-in-one on a single server (simulated or self-hosted DB/Kafka/S3):
#           make prod-up
#       - Cloud-managed services (AWS RDS/Neon, AWS S3/R2, ElastiCache, MSK):
#           make cloud-up
# ═══════════════════════════════════════════════════════════════════════════════

# ─── 1. Runtime & Public URLs ────────────────────────────────────────────────
APP_ENV=production
PORT=8080
HOSTNAME=0.0.0.0
NODE_ENV=production

# Public domains (replace "prim.example.com" with your real apex/subdomains):
CLIENT_BASE_URL=https://prim.example.com
CORS_ALLOWED_ORIGINS=https://prim.example.com,https://admin.prim.example.com

# Browser-facing API endpoint (baked into frontend bundle and used by clients):
NEXT_PUBLIC_API_URL=https://api.prim.example.com
NEXT_PUBLIC_SITE_URL=https://prim.example.com

# Internal server-to-server API call (within Docker network or private VPC):
API_URL=http://api:8080

# ─── 2. PostgreSQL Database (AWS RDS / Neon / Supabase) ──────────────────────
# Full PostgreSQL connection string with SSL required.
# Example: postgresql://prim_user:SuperSecretPassword123!@prim-db.c7x8y9.us-east-1.rds.amazonaws.com:5432/prim?sslmode=require
DATABASE_URL=postgresql://__DB_USER__:__DB_PASSWORD__@__DB_HOST__:5432/__DB_NAME__?sslmode=require

# Connection pool sizing:
DB_MAX_CONNS=25
DB_MIN_CONNS=5
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=30m

# ─── 3. Redis Cache & Sessions (AWS ElastiCache / Redis Cloud / Upstash) ─────
# Full connection string with TLS (use rediss:// for SSL):
# Example: rediss://default:StrongRedisAuthToken@prim-cache.redis.cache.amazonaws.com:6379/0
REDIS_URL=rediss://default:__REDIS_PASSWORD__@__REDIS_HOST__:6379/0

# ─── 4. Object Storage (AWS S3 or Cloudflare R2) ─────────────────────────────
# Set NEXT_PUBLIC_MEDIA_BASE_URL to your CDN distribution domain (e.g. CloudFront)
# or direct public bucket URL.

# ── Option A: AWS S3 ─────────────────────────────────────────────────────────
S3_ENDPOINT=s3.us-east-1.amazonaws.com
S3_REGION=us-east-1
S3_BUCKET=prim-media-production
S3_ACCESS_KEY=AKIA__YOUR_IAM_ACCESS_KEY__
S3_SECRET_KEY=__YOUR_IAM_SECRET_ACCESS_KEY__
S3_USE_SSL=true
S3_PUBLIC_URL=https://media.prim.example.com
NEXT_PUBLIC_MEDIA_BASE_URL=https://media.prim.example.com

# ── Option B: Cloudflare R2 (Uncomment if using R2 instead of S3) ────────────
# S3_ENDPOINT=__CLOUDFLARE_ACCOUNT_ID__.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=prim-media-production
# S3_ACCESS_KEY=__R2_ACCESS_KEY_ID__
# S3_SECRET_KEY=__R2_SECRET_ACCESS_KEY__
# S3_USE_SSL=true
# S3_PUBLIC_URL=https://media.prim.example.com
# NEXT_PUBLIC_MEDIA_BASE_URL=https://media.prim.example.com

# ─── 5. Apache Kafka Event Broker (AWS MSK / Confluent Cloud / Aiven) ────────
# Comma-separated list of bootstrap brokers:
# Example: b-1.prim-msk.us-east-1.amazonaws.com:9092,b-2.prim-msk.us-east-1.amazonaws.com:9092
KAFKA_BROKERS=__KAFKA_BROKER_1__:9092,__KAFKA_BROKER_2__:9092
KAFKA_GROUP_ID=prim-notification-workers

# ─── 6. Stripe Payments ──────────────────────────────────────────────────────
# Live production keys from Stripe Dashboard (https://dashboard.stripe.com/apikeys):
STRIPE_SECRET_KEY=sk_live___YOUR_LIVE_STRIPE_SECRET_KEY__
STRIPE_PUBLISHABLE_KEY=pk_live___YOUR_LIVE_STRIPE_PUBLISHABLE_KEY__
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live___YOUR_LIVE_STRIPE_PUBLISHABLE_KEY__

# Webhook endpoint secret from Stripe Dashboard -> Webhooks -> Add endpoint:
# URL: https://api.prim.example.com/api/v1/checkout/webhook
STRIPE_WEBHOOK_SECRET=whsec___YOUR_LIVE_WEBHOOK_SIGNING_SECRET__

# ─── 7. Transactional Email (Cheapest: AWS SES $0.10/1k, or Brevo 300/day free) ───
# Option A: AWS SES (Cheapest at scale — $0.10 per 1,000 emails, port 587 STARTTLS)
SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SMTP_PORT=587
SMTP_USERNAME=AKIA__YOUR_SES_SMTP_USERNAME__
SMTP_PASSWORD=__YOUR_SES_SMTP_PASSWORD__
SMTP_FROM_EMAIL=no-reply@prim.example.com
SMTP_FROM_NAME=PRIM Superstore

# Option B: Brevo / Sendinblue (Uncomment for 300 free emails/day forever)
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USERNAME=your-brevo-login-email@example.com
# SMTP_PASSWORD=__YOUR_BREVO_SMTP_KEY__
# SMTP_FROM_EMAIL=no-reply@prim.example.com
# SMTP_FROM_NAME=PRIM Superstore

# ─── 8. SMS Gateway (Twilio) ─────────────────────────────────────────────────
# Provider: "twilio" for live delivery or "log" for quiet logging
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=AC__YOUR_TWILIO_ACCOUNT_SID__
TWILIO_AUTH_TOKEN=__YOUR_TWILIO_AUTH_TOKEN__
TWILIO_FROM_PHONE=+1234567890

# ─── 9. Cryptographic Keys & Rate Limiting ───────────────────────────────────
# Generate with: openssl rand -base64 48
OTP_HASH_PEPPER=__GENERATE_SECURE_RANDOM_BASE64_KEY_HERE__

AUTH_CHALLENGE_TTL=5m
AUTH_SESSION_TTL=720h

# Production sliding-window rate limits:
RL_AUTH_START_REQUESTS=5
RL_AUTH_START_WINDOW=1m
RL_AUTH_RESEND_REQUESTS=3
RL_AUTH_RESEND_WINDOW=1m
RL_AUTH_VERIFY_REQUESTS=10
RL_AUTH_VERIFY_WINDOW=1m
RL_HISTORY_WRITE_REQUESTS=120
RL_HISTORY_WRITE_WINDOW=1m
